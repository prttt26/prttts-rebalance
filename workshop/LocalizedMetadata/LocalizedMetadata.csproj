<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SteamDataDir Condition="'$(SteamDataDir)' == ''">C:/Program Files (x86)/Steam/steamapps/common/Slay the Spire 2/data_sts2_windows_x86_64</SteamDataDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Steamworks.NET"><HintPath>$(SteamDataDir)/Steamworks.NET.dll</HintPath></Reference>
    <None Include="$(SteamDataDir)/steam_api64.dll" Link="steam_api64.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
